# OMNIS-X Environment Configuration Template
# Copy this file to .env and adjust variables as required for local or production deployment.

PROJECT_NAME="OMNIS-X Institutional Cyber-Physical Digital Twin"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# Database Configuration (Defaults to local SQLite file; replace with PostgreSQL if available)
DATABASE_URL="sqlite:///./omnis_x.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://omnis_user:secure_password@localhost:5432/omnis_x_db"

# JWT Authentication
JWT_SECRET_KEY="replace-this-with-a-cryptographically-secure-random-secret-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Computational Graph Settings
REBUILD_GRAPH_ON_STARTUP=true

# Logging
LOG_LEVEL="INFO"
